# Gerado a partir de _redirects e _headers (equivalente para Apache / cPanel / Hostinger).
Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Forca HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Aliases de arquivos (nomes antigos -> arquivos com hash)
RewriteRule ^fonts/cormorant-italic-variable\.ttf$ /fonts/cormorant-italic-variable.woff2 [L]
